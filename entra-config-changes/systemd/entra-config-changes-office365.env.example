# Environment for the Microsoft 365 (office365) admin config-change collector.
# Copy to /opt/entra-config-changes-digest/entra-config-changes.env (it can share the
# digest env file) or its own, fill in, then: chmod 600 <file>.
# This half reads the Wazuh Indexer only -- it does NOT call Microsoft Graph, so no
# MS_GRAPH_* secret is required here.

# Required: password of a (read-only) Wazuh Indexer user. WAZUH_INDEXER_PASSWORD is
# accepted as an alias (matches some Wazuh recipe deployments).
INDEX_PASSWORD=changeme
#WAZUH_INDEXER_PASSWORD=changeme

# Optional overrides (defaults shown):
#INDEX_URL=https://127.0.0.1:9200
#INDEX_USER=admin
#INDEX_PATTERN=wazuh-alerts-4.x-*
#CA=/etc/wazuh-indexer/certs/root-ca.pem
#NO_VERIFY=0                              # set 1 to skip indexer TLS verification (localhost)
#SMTP_SERVER=smtp.example.com             # or --smtp-server on the ExecStart line
#SMTP_PORT=25
#MAIL_FROM=wazuh@example.com
#RECIPIENTS=security@example.com          # or keep --recipients on the ExecStart line
#DASHBOARD_URL=https://wazuh.example.com
#LOOKBACK_HOURS=24                        # how far back each run scans (dedup covers overlap)
#STATE_DB=/opt/entra-config-changes-digest/office365-state.db
#SUPPRESS_NOISE=1                         # drop opaque .NET placeholder property values
#GROUP_TICKETS=1                          # one email per (admin + object); --no-group to disable
#DISPLAY_TZ=Europe/Vienna                 # timezone for the "When" field

# --- Noise / scope tuning (defaults shown) ------------------------------------------
# Gating is two-tier and UserType is unreliable (the Security/Compliance portal attributes
# the same admin's cmdlets to UserType 2 OR 5). So mutating "Verb-Noun" cmdlets
# (Set-/New-/Remove-...) are ALWAYS kept (RBAC-gated genuine config changes), while curated
# single-token ops (below) additionally require one of these human UserTypes -- which keeps
# application/service-principal automation (e.g. Defender's AddIndicator IoC sync) out.
#ADMIN_USERTYPES=2,3
# Escape hatch: workloads where curated ops are kept regardless of UserType (includes
# app/automation). EMPTY by default -- that is what keeps AddIndicator-style noise out.
#ALWAYS_ADMIN_WORKLOADS=
# Workloads pulled from the indexer (admin surfaces). The Endpoint/file firehose and
# Teams/SharePoint/OneDrive file activity are excluded; only admin cmdlet workloads +
# curated ops (below) are considered.
#OFFICE365_WORKLOADS=Exchange,SecurityComplianceCenter,MicrosoftDefenderForEndpoint,ThreatIntelligence,PowerPlatform,Microsoft365DefenderPortal,MicrosoftDefenderForCloudApps,Purview,Mip
# Extra single-token (non "Verb-Noun") operations treated as config changes, pulled even
# from otherwise-noisy workloads (e.g. Teams admin center actions).
#OFFICE365_CURATED_OPS=TeamsAdminAction,AddIndicator,SecurityRoleUpdated,SecurityRoleCreated
# Defender/XDR "settings" surfaces. Their admin config uses portal action names (not
# Verb-Noun cmdlets), so on these workloads ANY human-admin operation that isn't an obvious
# read/SOC action (see OFFICE365_SETTINGS_DENY) is treated as a config change. REQUIRES the
# Defender "Unified audit log" advanced feature to be ON (Settings > Endpoints > General >
# Advanced features) for events to reach the audit log at all.
#DEFENDER_SETTINGS_WORKLOADS=MicrosoftDefenderForEndpoint,Microsoft365Defender,Microsoft365DefenderPortal,MicrosoftDefenderExperts,MicrosoftDefenderForIdentity,MicrosoftDefenderForCloudApps
# Substrings marking an operation on a settings workload as read/SOC-operational -> dropped.
#OFFICE365_SETTINGS_DENY=search,validate,get,list,view,read,export,preview,aggregate,authorize,incident,remediat,isolat,response,investigat,hunt,query,signin,logon,login,alert,scan,comment,triage,submission,download,detail
# Exclude AzureActiveDirectory (RecordType 8) -- the Graph directoryAudits poller already
# owns Entra, and the office365 AAD feed is mostly system service-principal noise.
#OFFICE365_EXCLUDE_AAD=1
# Self-service / per-user Exchange cmdlets dropped outright. Outlook/OWA run these on the
# user's OWN mailbox (calendar, language, auto-reply, junk, inbox rules); Exchange logs them
# as admin-style Set-*/New-* cmdlets (often UserType=Admin) but they are NOT admin config.
# Add any others your tenant shows in --dry-run that are actually end-user actions.
#OFFICE365_IGNORE_OPS=Set-MailboxCalendarConfiguration,Set-MailboxRegionalConfiguration,Set-MailboxMessageConfiguration,Set-MailboxAutoReplyConfiguration,Set-MailboxCalendarFolder,Set-MailboxSpellingConfiguration,Set-MailboxJunkEmailConfiguration,Set-MailboxSearchPreference,Set-UserPhoto,Remove-UserPhoto,Set-Clutter,Set-FocusedInbox,Set-MailboxProfile,New-InboxRule,Set-InboxRule,Remove-InboxRule,Enable-InboxRule,Disable-InboxRule
# PowerShell common/uninteresting parameters dropped from the rendered parameter table.
#OFFICE365_IGNORE_PARAMS=confirm,whatif,erroraction,warningaction,force,verbose,debug,outvariable,outbuffer,pipelinevariable,informationaction,warningvariable,errorvariable,progressaction
# Actor identities (UserId / UserKey / ClientApplication) that are Microsoft datacenter/service
# principals, not humans (they report UserType=Admin but only run automated cmdlets, e.g.
# NT SERVICE\MSExchangeAdminApiNetCore running Remove-StoreMailbox). Case-insensitive substring
# match; comma-separated; dropped regardless of Operation. Add e.g. specific service UPNs,
# "microsoft.exchange." (Exchange service ClientApplication), or app GUIDs as needed.
#OFFICE365_ACTOR_DENY=nt service\,nt authority\

# Where opensearch-py is importable from (usually already on the venv's sys.path).
#WAZUH_RECIPES_LIB=/opt/wazuh-recipes/lib
